POSTGRES_DB=smartcare
POSTGRES_USER=smartcare
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
SMARTCARE_JWT_SECRET=replace-with-at-least-32-random-characters-before-running
SMARTCARE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
SMARTCARE_ONLINE_RESERVATION_TTL=10m
SMARTCARE_CASH_GRACE_PERIOD=15m
SMARTCARE_CANCELLATION_CUTOFF=2h
SMARTCARE_CHECK_IN_OPENS_BEFORE=4h
SMARTCARE_CHECK_IN_CLOSES_AFTER=2h
SMARTCARE_NOTIFICATION_CHANNELS=IN_APP
SMARTCARE_DEMO_DATA=false
SMARTCARE_BLOOD_VERIFICATION_MAX_AGE=6h
SMARTCARE_PAYMENT_PROVIDER=DEVELOPMENT
SMARTCARE_PAYMENT_WEBHOOK_SECRET=replace-with-at-least-32-random-characters-before-running
SMARTCARE_PAYMENT_INTENT_TTL=10m
FRONTEND_PORT=5174

# Local development adapter only. Docker Compose mounts this path on a private named volume.
SMARTCARE_DOCUMENT_STORAGE_PATH=/var/lib/smartcare/private-documents
SMARTCARE_AI_REQUESTS_PER_MINUTE=12

# Optional one-time SUPER_ADMIN bootstrap. Disable after the first successful start.
SMARTCARE_BOOTSTRAP_ADMIN=false
SMARTCARE_ADMIN_MOBILE=+919999999999
SMARTCARE_ADMIN_EMAIL=admin@example.com
SMARTCARE_ADMIN_PASSWORD=replace-with-a-strong-unique-password
SMARTCARE_ADMIN_NAME=SmartCare Administrator
