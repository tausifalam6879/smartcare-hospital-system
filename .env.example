POSTGRES_DB=raahmediq
POSTGRES_USER=raahmediq
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
RAAHMEDIQ_JWT_SECRET=replace-with-at-least-32-random-characters-before-running
RAAHMEDIQ_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RAAHMEDIQ_ONLINE_RESERVATION_TTL=10m
RAAHMEDIQ_CASH_GRACE_PERIOD=15m
RAAHMEDIQ_CANCELLATION_CUTOFF=2h
RAAHMEDIQ_CHECK_IN_OPENS_BEFORE=4h
RAAHMEDIQ_CHECK_IN_CLOSES_AFTER=2h
RAAHMEDIQ_NOTIFICATION_CHANNELS=IN_APP
RAAHMEDIQ_DEMO_DATA=false
RAAHMEDIQ_BLOOD_VERIFICATION_MAX_AGE=6h
RAAHMEDIQ_PAYMENT_PROVIDER=DEVELOPMENT
RAAHMEDIQ_PAYMENT_WEBHOOK_SECRET=replace-with-at-least-32-random-characters-before-running
RAAHMEDIQ_PAYMENT_INTENT_TTL=10m

# Local development adapter only. Docker Compose mounts this path on a private named volume.
RAAHMEDIQ_DOCUMENT_STORAGE_PATH=/var/lib/raahmediq/private-documents
RAAHMEDIQ_AI_REQUESTS_PER_MINUTE=12

# Optional one-time SUPER_ADMIN bootstrap. Disable after the first successful start.
RAAHMEDIQ_BOOTSTRAP_ADMIN=false
RAAHMEDIQ_ADMIN_MOBILE=+919999999999
RAAHMEDIQ_ADMIN_EMAIL=admin@example.com
RAAHMEDIQ_ADMIN_PASSWORD=replace-with-a-strong-unique-password
RAAHMEDIQ_ADMIN_NAME=RaahMediQ Health Administrator
